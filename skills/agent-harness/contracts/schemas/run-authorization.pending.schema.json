{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ios-experts:schema:run-authorization-pending:1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "contract_schema_id",
    "contract_schema_sha256",
    "run_id",
    "authorization_id",
    "decision",
    "actor",
    "selected_writer",
    "issued_at",
    "expires_at",
    "delivery_target",
    "health_profile",
    "health_attestation",
    "resource_plan",
    "repository",
    "spec_kit",
    "acceptance_ids",
    "allowed_paths",
    "limits",
    "github",
    "apple",
    "action_grants",
    "forbidden_actions",
    "auto_merge",
    "app_review_submit",
    "credential_scope_expansion",
    "signing_resource_mutation",
    "destructive_cleanup"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "contract_schema_id": {
      "enum": [null, "urn:ios-experts:schema:run-authorization-pending:1.0.0"]
    },
    "contract_schema_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {"const": null},
    "authorization_id": {"const": null},
    "decision": {"const": "pending"},
    "actor": {"const": null},
    "selected_writer": {"const": null},
    "issued_at": {"const": null},
    "expires_at": {"const": null},
    "delivery_target": {
      "enum": ["pr_ready", "testflight_uploaded", "testflight_distributed"]
    },
    "health_profile": {"const": "pr_ready"},
    "health_attestation": {"const": null},
    "resource_plan": {"const": []},
    "repository": {"const": null},
    "spec_kit": {"const": null},
    "acceptance_ids": {"const": []},
    "allowed_paths": {"const": []},
    "limits": {
      "const": {
        "max_implementation_attempts": 3,
        "max_review_cycles": 2,
        "max_transient_retries": 1,
        "active_wall_minutes": 45,
        "async_wait_minutes": 45
      }
    },
    "github": {"const": null},
    "apple": {"const": null},
    "action_grants": {"const": []},
    "forbidden_actions": {
      "const": [
        "git.force_push",
        "github.auto_merge",
        "github.ruleset_change",
        "apple.app_review_submit",
        "apple.production_release",
        "apple.signing_resource_mutation",
        "credential.scope_expansion",
        "environment.destructive_cleanup"
      ]
    },
    "auto_merge": {"const": false},
    "app_review_submit": {"const": false},
    "credential_scope_expansion": {"const": false},
    "signing_resource_mutation": {"const": false},
    "destructive_cleanup": {"const": false}
  },
  "additionalProperties": false
}
