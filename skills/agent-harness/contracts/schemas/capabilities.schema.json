{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ios-experts:schema:capabilities:1.0.0",
  "$comment": "Shape only. capabilities.json is the one place capability values are declared; the Swift runtime pins them with CapabilityPolicy.reviewedSHA256, and Swift that implements a declared value changes with it.",
  "type": "object",
  "required": [
    "schema_version",
    "modes",
    "platforms",
    "local_llm",
    "feedback_policy",
    "authority_order",
    "knowledge_orders",
    "execution_order",
    "delivery_profiles",
    "health_policy",
    "spec_kit_policy",
    "companion_upstream_policy",
    "xcode_mcp_provider_policy",
    "resource_scopes",
    "resource_key_fields",
    "resource_overlap_policy",
    "cross_run_coordination_policy",
    "runtime_registry_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "modes": {
      "type": "object",
      "required": ["codex", "claude", "collaborative"],
      "properties": {
        "codex": {"$ref": "#/$defs/single_writer_mode"},
        "claude": {"$ref": "#/$defs/single_writer_mode"},
        "collaborative": {
          "type": "object",
          "required": [
            "writer_candidates",
            "max_active_writers",
            "review_requires_immutable_patch",
            "writer_selection",
            "transfer_policy"
          ],
          "properties": {
            "writer_candidates": {"$ref": "#/$defs/names"},
            "max_active_writers": {"$ref": "#/$defs/positive_integer"},
            "review_requires_immutable_patch": {"type": "boolean"},
            "writer_selection": {
              "type": "object",
              "required": ["required_before_claim", "authority", "reviewer_must_differ"],
              "properties": {
                "required_before_claim": {"type": "boolean"},
                "authority": {"$ref": "#/$defs/name"},
                "reviewer_must_differ": {"type": "boolean"}
              },
              "additionalProperties": false
            },
            "transfer_policy": {
              "type": "object",
              "required": [
                "release_before_acquire",
                "revoke_previous_writer_capabilities",
                "matching_state_hash_required",
                "fresh_capability_snapshot_required"
              ],
              "properties": {
                "release_before_acquire": {"type": "boolean"},
                "revoke_previous_writer_capabilities": {"type": "boolean"},
                "matching_state_hash_required": {"type": "boolean"},
                "fresh_capability_snapshot_required": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "platforms": {"$ref": "#/$defs/names"},
    "local_llm": {
      "type": "object",
      "required": ["allowed_roles", "forbidden_roles"],
      "properties": {
        "allowed_roles": {"$ref": "#/$defs/names"},
        "forbidden_roles": {"$ref": "#/$defs/names"}
      },
      "additionalProperties": false
    },
    "feedback_policy": {
      "type": "object",
      "required": [
        "record_in_ledger",
        "current_run_feedback_is_authoritative",
        "silent_durable_policy_mutation",
        "durable_promotion_requires",
        "local_llm_role",
        "rollback_required"
      ],
      "properties": {
        "record_in_ledger": {"type": "boolean"},
        "current_run_feedback_is_authoritative": {"type": "boolean"},
        "silent_durable_policy_mutation": {"type": "boolean"},
        "durable_promotion_requires": {"$ref": "#/$defs/name"},
        "local_llm_role": {"$ref": "#/$defs/name"},
        "rollback_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "authority_order": {"$ref": "#/$defs/names"},
    "knowledge_orders": {
      "type": "object",
      "required": ["product_truth", "apple_api_truth"],
      "properties": {
        "product_truth": {"$ref": "#/$defs/names"},
        "apple_api_truth": {"$ref": "#/$defs/names"}
      },
      "additionalProperties": false
    },
    "execution_order": {"$ref": "#/$defs/names"},
    "delivery_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["terminal", "continuation"],
        "properties": {
          "terminal": {"$ref": "#/$defs/name"},
          "continuation": {"type": ["string", "null"], "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "health_policy": {
      "type": "object",
      "required": [
        "statuses",
        "required_profile_before_writes",
        "read_only_observation",
        "repair_or_install",
        "account_or_scope_expansion",
        "separate_app_and_infrastructure_results"
      ],
      "properties": {
        "statuses": {"$ref": "#/$defs/names"},
        "required_profile_before_writes": {"type": "boolean"},
        "read_only_observation": {"type": "boolean"},
        "repair_or_install": {"type": "boolean"},
        "account_or_scope_expansion": {"type": "boolean"},
        "separate_app_and_infrastructure_results": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "spec_kit_policy": {
      "type": "object",
      "required": [
        "pinned_release",
        "artifact_hash_binding",
        "feature_directory_and_git_branch_mapping_is_explicit",
        "workflow_checkpoint_separate_from_authorization_hash",
        "workflow_logs_are_subordinate_to_harness_ledger",
        "managed_workflow_definitions_change_via_supported_overlays_only"
      ],
      "properties": {
        "pinned_release": {"$ref": "#/$defs/name"},
        "artifact_hash_binding": {"type": "boolean"},
        "feature_directory_and_git_branch_mapping_is_explicit": {"type": "boolean"},
        "workflow_checkpoint_separate_from_authorization_hash": {"type": "boolean"},
        "workflow_logs_are_subordinate_to_harness_ledger": {"type": "boolean"},
        "managed_workflow_definitions_change_via_supported_overlays_only": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "companion_upstream_policy": {
      "type": "object",
      "required": [
        "mode",
        "public_metadata_read_only",
        "execute_or_vendor",
        "drift_action",
        "auto_merge"
      ],
      "properties": {
        "mode": {"$ref": "#/$defs/name"},
        "public_metadata_read_only": {"type": "boolean"},
        "execute_or_vendor": {"type": "boolean"},
        "drift_action": {"$ref": "#/$defs/name"},
        "auto_merge": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "xcode_mcp_provider_policy": {
      "type": "object",
      "required": [
        "state_dimensions",
        "record_install_provenance",
        "same_codex_host_clients_share_configuration",
        "provider_injection_layers",
        "capability_results",
        "read_only_probe_timeout_seconds",
        "max_unchanged_read_only_retries",
        "official_external_agent_route_first",
        "configuration_mutation_requires_explicit_approval",
        "max_active_simulator_capable_providers_during_incident",
        "verification_order",
        "forbidden_security_mode",
        "forbidden_automatic_actions"
      ],
      "properties": {
        "state_dimensions": {"$ref": "#/$defs/names"},
        "record_install_provenance": {"$ref": "#/$defs/names"},
        "same_codex_host_clients_share_configuration": {"type": "boolean"},
        "provider_injection_layers": {"$ref": "#/$defs/names"},
        "capability_results": {"$ref": "#/$defs/names"},
        "read_only_probe_timeout_seconds": {"$ref": "#/$defs/positive_integer"},
        "max_unchanged_read_only_retries": {"$ref": "#/$defs/count"},
        "official_external_agent_route_first": {"type": "boolean"},
        "configuration_mutation_requires_explicit_approval": {"type": "boolean"},
        "max_active_simulator_capable_providers_during_incident": {"$ref": "#/$defs/count"},
        "verification_order": {"$ref": "#/$defs/names"},
        "forbidden_security_mode": {"$ref": "#/$defs/name"},
        "forbidden_automatic_actions": {"$ref": "#/$defs/names"}
      },
      "additionalProperties": false
    },
    "resource_scopes": {"$ref": "#/$defs/names"},
    "resource_key_fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/names"}
    },
    "resource_overlap_policy": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"anyOf": [{"$ref": "#/$defs/name"}, {"$ref": "#/$defs/names"}]}
      }
    },
    "cross_run_coordination_policy": {
      "type": "object",
      "required": [
        "required_for",
        "coordinator_scope",
        "atomic_acquire_required",
        "execution_environment_supplies_state_path",
        "live_receipt_verification_before_reservation",
        "live_receipt_verification_before_dispatch",
        "max_ttl_seconds",
        "trusted_binding",
        "receipt_binding_fields",
        "registry_is_lock",
        "per_run_ledger_is_lock",
        "bootstrap",
        "unavailable_outcome",
        "lease_expiry",
        "forbidden_automatic_actions"
      ],
      "properties": {
        "required_for": {"$ref": "#/$defs/name"},
        "coordinator_scope": {"$ref": "#/$defs/name"},
        "atomic_acquire_required": {"type": "boolean"},
        "execution_environment_supplies_state_path": {"type": "boolean"},
        "live_receipt_verification_before_reservation": {"type": "boolean"},
        "live_receipt_verification_before_dispatch": {"type": "boolean"},
        "max_ttl_seconds": {"$ref": "#/$defs/positive_integer"},
        "trusted_binding": {
          "type": "object",
          "required": ["source", "required_fields", "same_binding_for_all_clients"],
          "properties": {
            "source": {"$ref": "#/$defs/name"},
            "required_fields": {"$ref": "#/$defs/names"},
            "same_binding_for_all_clients": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "receipt_binding_fields": {"$ref": "#/$defs/names"},
        "registry_is_lock": {"type": "boolean"},
        "per_run_ledger_is_lock": {"type": "boolean"},
        "bootstrap": {
          "type": "object",
          "required": ["legacy_leases_quiesced_confirmation_required", "automatic_migration"],
          "properties": {
            "legacy_leases_quiesced_confirmation_required": {"type": "boolean"},
            "automatic_migration": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "unavailable_outcome": {
          "type": "object",
          "required": ["graph_state", "reason_code"],
          "properties": {
            "graph_state": {"$ref": "#/$defs/name"},
            "reason_code": {"$ref": "#/$defs/name"}
          },
          "additionalProperties": false
        },
        "lease_expiry": {
          "type": "object",
          "required": ["silent_takeover", "recovery_record_required", "recovery_requires"],
          "properties": {
            "silent_takeover": {"type": "boolean"},
            "recovery_record_required": {"type": "boolean"},
            "recovery_requires": {"$ref": "#/$defs/names"}
          },
          "additionalProperties": false
        },
        "forbidden_automatic_actions": {"$ref": "#/$defs/names"}
      },
      "additionalProperties": false
    },
    "runtime_registry_policy": {
      "type": "object",
      "required": [
        "failure_class",
        "normalized_signatures",
        "minimum_repeat_observations",
        "supporting_enumeration_gap_seconds",
        "supporting_evidence_not_causal_proof",
        "restart_resets_processes_not_persisted_registry",
        "max_active_simulator_tool_providers_during_diagnosis",
        "max_new_bounded_discovery_probes",
        "recovery_resource",
        "conflicts_with",
        "mutation_requires_matching_approval",
        "mutating_approval_binding",
        "mutating_approval_single_use",
        "privileged_diagnostics_require_explicit_approval",
        "release_note_precedent_is_not_defect_equivalence",
        "verification_order",
        "verification_repetitions",
        "toolchain_comparison",
        "forbidden_automatic_actions"
      ],
      "properties": {
        "failure_class": {"$ref": "#/$defs/name"},
        "normalized_signatures": {"$ref": "#/$defs/names"},
        "minimum_repeat_observations": {"$ref": "#/$defs/positive_integer"},
        "supporting_enumeration_gap_seconds": {"$ref": "#/$defs/positive_integer"},
        "supporting_evidence_not_causal_proof": {"$ref": "#/$defs/names"},
        "restart_resets_processes_not_persisted_registry": {"type": "boolean"},
        "max_active_simulator_tool_providers_during_diagnosis": {"$ref": "#/$defs/count"},
        "max_new_bounded_discovery_probes": {"$ref": "#/$defs/count"},
        "recovery_resource": {"$ref": "#/$defs/name"},
        "conflicts_with": {"$ref": "#/$defs/names"},
        "mutation_requires_matching_approval": {"type": "boolean"},
        "mutating_approval_binding": {"$ref": "#/$defs/names"},
        "mutating_approval_single_use": {"type": "boolean"},
        "privileged_diagnostics_require_explicit_approval": {"type": "boolean"},
        "release_note_precedent_is_not_defect_equivalence": {"type": "boolean"},
        "verification_order": {"$ref": "#/$defs/names"},
        "verification_repetitions": {
          "type": "object",
          "required": ["default", "stability_acceptance"],
          "properties": {
            "default": {"$ref": "#/$defs/positive_integer"},
            "stability_acceptance": {"$ref": "#/$defs/positive_integer"}
          },
          "additionalProperties": false
        },
        "toolchain_comparison": {"$ref": "#/$defs/name"},
        "forbidden_automatic_actions": {"$ref": "#/$defs/names"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "count": {"type": "integer", "minimum": 0},
    "positive_integer": {"type": "integer", "minimum": 1},
    "single_writer_mode": {
      "type": "object",
      "required": ["writer_candidates", "max_active_writers"],
      "properties": {
        "writer_candidates": {"$ref": "#/$defs/names"},
        "max_active_writers": {"$ref": "#/$defs/positive_integer"}
      },
      "additionalProperties": false
    }
  }
}
