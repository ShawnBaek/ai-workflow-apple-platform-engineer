{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ios-experts:schema:capabilities:1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "modes",
    "platforms",
    "local_llm",
    "feedback_policy",
    "authority_order",
    "knowledge_orders",
    "execution_order",
    "delivery_profiles",
    "health_policy",
    "spec_kit_policy",
    "companion_upstream_policy",
    "xcode_mcp_provider_policy",
    "resource_scopes",
    "resource_key_fields",
    "resource_overlap_policy",
    "cross_run_coordination_policy",
    "runtime_registry_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "modes": {
      "type": "object",
      "required": ["codex", "claude", "collaborative"],
      "properties": {
        "codex": {
          "type": "object",
          "required": ["writer_candidates", "max_active_writers"],
          "properties": {
            "writer_candidates": {"const": ["codex"]},
            "max_active_writers": {"const": 1}
          },
          "additionalProperties": false
        },
        "claude": {
          "type": "object",
          "required": ["writer_candidates", "max_active_writers"],
          "properties": {
            "writer_candidates": {"const": ["claude"]},
            "max_active_writers": {"const": 1}
          },
          "additionalProperties": false
        },
        "collaborative": {
          "type": "object",
          "required": [
            "writer_candidates",
            "max_active_writers",
            "review_requires_immutable_patch",
            "writer_selection",
            "transfer_policy"
          ],
          "properties": {
            "writer_candidates": {"const": ["codex", "claude"]},
            "max_active_writers": {"const": 1},
            "review_requires_immutable_patch": {"const": true},
            "writer_selection": {
              "type": "object",
              "required": ["required_before_claim", "authority", "reviewer_must_differ"],
              "properties": {
                "required_before_claim": {"const": true},
                "authority": {"const": "explicit_user_or_accepted_plan"},
                "reviewer_must_differ": {"const": true}
              },
              "additionalProperties": false
            },
            "transfer_policy": {
              "type": "object",
              "required": [
                "release_before_acquire",
                "revoke_previous_writer_capabilities",
                "matching_state_hash_required",
                "fresh_capability_snapshot_required"
              ],
              "properties": {
                "release_before_acquire": {"const": true},
                "revoke_previous_writer_capabilities": {"const": true},
                "matching_state_hash_required": {"const": true},
                "fresh_capability_snapshot_required": {"const": true}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "platforms": {"const": ["ios", "ipados", "watchos", "macos"]},
    "local_llm": {
      "type": "object",
      "required": ["allowed_roles", "forbidden_roles"],
      "properties": {
        "allowed_roles": {"const": ["retrieve", "rerank", "extract_entities", "cluster_logs"]},
        "forbidden_roles": {"const": ["writer", "approver", "reviewer_of_record"]}
      },
      "additionalProperties": false
    },
    "feedback_policy": {
      "type": "object",
      "required": [
        "record_in_ledger",
        "current_run_feedback_is_authoritative",
        "silent_durable_policy_mutation",
        "durable_promotion_requires",
        "local_llm_role",
        "rollback_required"
      ],
      "properties": {
        "record_in_ledger": {"const": true},
        "current_run_feedback_is_authoritative": {"const": true},
        "silent_durable_policy_mutation": {"const": false},
        "durable_promotion_requires": {
          "const": "explicit_human_approval_or_repeated_evidence"
        },
        "local_llm_role": {"const": "cluster_and_propose_only"},
        "rollback_required": {"const": true}
      },
      "additionalProperties": false
    },
    "authority_order": {
      "const": [
        "system_and_current_user",
        "hard_account_and_repository_guards",
        "accepted_spec_and_decisions",
        "repository_defaults"
      ]
    },
    "knowledge_orders": {
      "type": "object",
      "required": ["product_truth", "apple_api_truth"],
      "properties": {
        "product_truth": {
          "const": [
            "accepted_spec_and_decisions",
            "repository_source_at_frozen_head",
            "commit_pinned_dependency_source",
            "approved_project_analysis"
          ]
        },
        "apple_api_truth": {
          "const": [
            "live_apple_documentation_for_selected_toolchain",
            "one_apple_authored_skill_exposure",
            "commit_pinned_apple_sample",
            "ios_experts",
            "external_retrieved_material"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_order": {
      "const": [
        "xcode_official_tools",
        "apple_supported_external_agent_bridge",
        "host_apple_cli",
        "explicit_third_party_fallback"
      ]
    },
    "delivery_profiles": {
      "const": {
        "pr_ready": {
          "terminal": "pr_ready",
          "continuation": null
        },
        "testflight_uploaded": {
          "terminal": "testflight_uploaded",
          "continuation": "testflight-workflow.json"
        },
        "testflight_distributed": {
          "terminal": "testflight_distributed",
          "continuation": "testflight-workflow.json"
        }
      }
    },
    "health_policy": {
      "const": {
        "statuses": ["healthy", "degraded", "blocked", "not_applicable"],
        "required_profile_before_writes": true,
        "read_only_observation": true,
        "repair_or_install": false,
        "account_or_scope_expansion": false,
        "separate_app_and_infrastructure_results": true
      }
    },
    "spec_kit_policy": {
      "const": {
        "pinned_release": "v1.0.1",
        "artifact_hash_binding": true,
        "feature_directory_and_git_branch_mapping_is_explicit": true,
        "workflow_checkpoint_separate_from_authorization_hash": true,
        "workflow_logs_are_subordinate_to_harness_ledger": true,
        "managed_workflow_definitions_change_via_supported_overlays_only": true
      }
    },
    "companion_upstream_policy": {
      "const": {
        "mode": "reference-only",
        "public_metadata_read_only": true,
        "execute_or_vendor": false,
        "drift_action": "create_or_update_review_issue",
        "auto_merge": false
      }
    },
    "xcode_mcp_provider_policy": {
      "const": {
        "state_dimensions": [
          "installation",
          "registration",
          "current_task_exposure",
          "read_only_connectivity",
          "exact_workspace_binding"
        ],
        "record_install_provenance": [
          "config_scope",
          "configured_command_and_args",
          "resolved_executable",
          "package_manager_owner",
          "resolved_version"
        ],
        "same_codex_host_clients_share_configuration": true,
        "provider_injection_layers": [
          "official_codex_mcpbridge",
          "direct_codex_mcp",
          "codex_plugin_mcp",
          "xcode_agent_plugin"
        ],
        "capability_results": [
          "workspace_discovery",
          "interaction_session",
          "workspace_bound_run",
          "hierarchy_touch_capture",
          "direct_apple_cli"
        ],
        "read_only_probe_timeout_seconds": 30,
        "max_unchanged_read_only_retries": 1,
        "official_external_agent_route_first": true,
        "configuration_mutation_requires_explicit_approval": true,
        "max_active_simulator_capable_providers_during_incident": 1,
        "verification_order": [
          "configured_and_enabled",
          "fresh_client_or_task_exposes_tools",
          "read_only_workspace_response",
          "exact_workspace_identifier_selected"
        ],
        "forbidden_security_mode": "blanket_unsafe_allow_all_agents",
        "forbidden_automatic_actions": [
          "provider_install_update_uninstall_or_config_mutation",
          "provider_process_force_termination",
          "build_or_destination_inventory_as_connectivity_probe"
        ]
      }
    },
    "resource_scopes": {
      "const": [
        "source_checkout_writer",
        "xcode_project_mutation",
        "build_tuple",
        "simulator_or_device",
        "coresimulator_runtime_registry",
        "macos_gui_session",
        "signing_or_app_store_connect",
        "github_external_mutation"
      ]
    },
    "resource_key_fields": {
      "type": "object",
      "required": [
        "source_checkout_writer",
        "xcode_project_mutation",
        "build_tuple",
        "simulator_or_device",
        "coresimulator_runtime_registry",
        "macos_gui_session",
        "signing_or_app_store_connect",
        "github_external_mutation"
      ],
      "properties": {
        "source_checkout_writer": {"const": ["identity_version", "repository_fingerprint"]},
        "xcode_project_mutation": {"const": ["repository_fingerprint", "container_path"]},
        "build_tuple": {
          "const": ["repository_fingerprint", "container_path", "xcode_build", "sdk", "scheme", "configuration", "architecture", "package_fingerprint", "cache_paths", "cache_roles", "output_paths", "output_roles", "package_resolution_mode"]
        },
        "simulator_or_device": {"const": ["coordinator_instance_id", "udids"]},
        "coresimulator_runtime_registry": {"const": ["coordinator_instance_id", "registry_scope"]},
        "macos_gui_session": {"const": ["coordinator_instance_id", "session_scope"]},
        "signing_or_app_store_connect": {"const": ["account_guard", "app_or_bundle_scope"]},
        "github_external_mutation": {"const": ["repository_fingerprint", "remote_repository"]}
      },
      "additionalProperties": false
    },
    "resource_overlap_policy": {
      "const": {
        "source_checkout_writer": {
          "identity_version": "github_remote_v2",
          "identity": "normalized_repository_fingerprint",
          "conflict_when": "repository_fingerprint_equal",
          "canonical_root_role": "exact_authorization_target_excluded_from_writer_identity",
          "cross_resource_conflict": "xcode_project_or_build_same_repository_fingerprint",
          "same_owner_nested_exception": "source_with_xcode_or_build_only"
        },
        "xcode_project_mutation": {
          "identity_fields": ["repository_fingerprint", "container_path"],
          "container_path_normalization": "canonical_absolute_path",
          "conflict_when": "repository_fingerprint_or_canonical_container_path_equal",
          "cross_resource_conflict": "source_or_build_same_repository_fingerprint"
        },
        "simulator_or_device": {
          "identity_fields": ["coordinator_instance_id", "udids"],
          "host_identity_source": "coordinator_instance_id",
          "udids_normalization": "sorted_unique_nonempty",
          "conflict_when": "same_host_and_udid_intersection_nonempty",
          "evidence_only_fields": ["platform", "run_id", "bundle_id"]
        },
        "build_tuple": {
          "identity_fields": ["repository_fingerprint", "container_path", "xcode_build", "sdk", "scheme", "configuration", "architecture", "package_fingerprint", "cache_paths", "cache_roles", "output_paths", "output_roles", "package_resolution_mode"],
          "cache_paths_normalization": "canonical_absolute_sorted_unique_nonempty",
          "required_cache_roles": ["derived_data", "source_packages", "repository_checkouts", "artifacts", "package_cache"],
          "cache_role_policy": "cache_paths_equal_unique_role_values",
          "output_role_policy": "declared_xcode_result_archive_export_and_diagnostic_paths",
          "package_resolution_modes": ["none", "swiftpm_lockfile", "xcode_project_packages"],
          "resolution_mutation_requires": "same_owner_source_writer_and_xcode_project_lease_when_applicable",
          "conflict_when": "canonical_cache_or_output_path_tree_overlap_or_same_repository_when_either_resolves_packages",
          "path_alias_policy": "samefile_then_unicode_casefolded_tree_overlap",
          "cross_resource_conflict": "source_or_xcode_same_repository_fingerprint"
        },
        "coresimulator_runtime_registry": {
          "identity_fields": ["coordinator_instance_id", "registry_scope"],
          "conflict_when": "same_host_conflicts_with_every_device_lease"
        },
        "macos_gui_session": {
          "identity_fields": ["coordinator_instance_id", "session_scope"],
          "session_scope": "foreground_ui",
          "conflict_when": "same_host_foreground_ui_session"
        },
        "signing_or_app_store_connect": {
          "identity_fields": ["account_guard", "app_or_bundle_scope"],
          "conflict_when": "exact_account_and_app_scope_equal"
        },
        "github_external_mutation": {
          "identity_fields": ["repository_fingerprint", "remote_repository"],
          "remote_normalization": "lowercase_owner_repository_without_dot_git",
          "conflict_when": "repository_fingerprint_or_remote_equal"
        }
      }
    },
    "cross_run_coordination_policy": {
      "const": {
        "required_for": "every_mutating_resource_acquire",
        "coordinator_scope": "configured_host_shared_file",
        "atomic_acquire_required": true,
        "execution_environment_supplies_state_path": true,
        "live_receipt_verification_before_reservation": true,
        "live_receipt_verification_before_dispatch": true,
        "max_ttl_seconds": 3600,
        "trusted_binding": {
          "source": "private_harness",
          "required_fields": ["state_path", "coordinator_instance_id", "script_sha256", "contract_bundle_sha256"],
          "same_binding_for_all_clients": true
        },
        "receipt_binding_fields": [
          "coordinator_instance_id",
          "receipt_id",
          "lease_id",
          "owner_run_id",
          "owner_actor",
          "resource",
          "resource_key",
          "descriptor_sha256",
          "fencing_token",
          "acquired_at",
          "expires_at"
        ],
        "registry_is_lock": false,
        "per_run_ledger_is_lock": false,
        "bootstrap": {
          "legacy_leases_quiesced_confirmation_required": true,
          "automatic_migration": false
        },
        "unavailable_outcome": {
          "graph_state": "blocked",
          "reason_code": "coordination_required"
        },
        "lease_expiry": {
          "silent_takeover": false,
          "recovery_record_required": true,
          "recovery_requires": [
            "previous_receipt_and_fencing_token",
            "independent_observer_run",
            "owner_confirmed_dead",
            "owner_tool_children_confirmed_dead",
            "dirty_state_clean_digest",
            "live_resource_revalidation_digest"
          ]
        },
        "forbidden_automatic_actions": [
          "create_daemon",
          "create_database",
          "create_or_switch_worktree"
        ]
      }
    },
    "runtime_registry_policy": {
      "const": {
        "failure_class": "coresimulator_runtime_disk_registration",
        "normalized_signatures": ["unable to get a dev_t for store <store-id>"],
        "minimum_repeat_observations": 2,
        "supporting_enumeration_gap_seconds": 30,
        "supporting_evidence_not_causal_proof": [
          "simdiskimaged_process_continuity",
          "mixed_build_or_image_kind_inventory",
          "large_runtime_count",
          "low_free_storage"
        ],
        "restart_resets_processes_not_persisted_registry": true,
        "max_active_simulator_tool_providers_during_diagnosis": 1,
        "max_new_bounded_discovery_probes": 1,
        "recovery_resource": "coresimulator_runtime_registry",
        "conflicts_with": ["simulator_or_device"],
        "mutation_requires_matching_approval": true,
        "mutating_approval_binding": [
          "approval_id",
          "resource_key",
          "allowed_action",
          "runtime_identifier"
        ],
        "mutating_approval_single_use": true,
        "privileged_diagnostics_require_explicit_approval": true,
        "release_note_precedent_is_not_defect_equivalence": true,
        "verification_order": [
          "one_bounded_runtime_inventory",
          "release_runtime_registry_lease",
          "acquire_control_destination_lease",
          "one_designated_control_destination"
        ],
        "verification_repetitions": {
          "default": 1,
          "stability_acceptance": 3
        },
        "toolchain_comparison": "sequential_one_provider_fixed_non_toolchain_inputs_record_runtime_confounders",
        "forbidden_automatic_actions": [
          "direct_registry_runtime_or_mount_mutation",
          "daemon_or_service_force_termination",
          "global_device_or_runtime_removal",
          "derived_data_deletion"
        ]
      }
    }
  },
  "additionalProperties": false
}
