{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ios-experts:schema:harness:1.0.0",
  "type": "object",
  "required": [
    "agent_skills",
    "apple_observation_probe",
    "authoritative_root",
    "authorization_runtime",
    "delivery_target",
    "github_tracking",
    "health_components",
    "health_profile",
    "local_requirements",
    "max_active_repository_writers",
    "max_implementation_attempts",
    "max_review_cycles",
    "mode",
    "platforms",
    "private_policy_overlay",
    "resource_coordinator",
    "reviewer",
    "run_authorization",
    "run_ledger",
    "schema_version",
    "selected_writer",
    "spec_kit",
    "xcode_container"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "mode": {"enum": ["codex", "claude", "collaborative"]},
    "selected_writer": {"enum": ["codex", "claude"]},
    "reviewer": {"type": ["string", "null"]},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ios", "ipados", "watchos", "macos"]}
    },
    "delivery_target": {
      "enum": ["local_verified", "pr_ready", "testflight_uploaded", "testflight_distributed"]
    },
    "health_profile": {
      "enum": ["local_verified", "pr_ready", "runtime_ui", "testflight_uploaded", "testflight_distributed", "icon_upstream"]
    },
    "health_components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["project_registry", "spec_kit", "xcode_mcp", "apple_sample_code_mcp", "github_project", "local_llm"]
      }
    },
    "agent_skills": {
      "type": "object",
      "required": ["task_skills", "expected_bundle_sha256", "installations"],
      "properties": {
        "task_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "expected_bundle_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "installations": {
          "type": "object",
          "required": ["codex", "claude"],
          "properties": {
            "codex": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "collection_root": {
                      "type": "string",
                      "minLength": 2,
                      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                    },
                    "search_roots": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 2,
                        "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                      }
                    }
                  },
                  "oneOf": [
                    {"required": ["collection_root"], "not": {"required": ["search_roots"]}},
                    {"required": ["search_roots"], "not": {"required": ["collection_root"]}}
                  ],
                  "additionalProperties": false
                },
                {"type": "null"}
              ]
            },
            "claude": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "collection_root": {
                      "type": "string",
                      "minLength": 2,
                      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                    },
                    "search_roots": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 2,
                        "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
                      }
                    }
                  },
                  "oneOf": [
                    {"required": ["collection_root"], "not": {"required": ["search_roots"]}},
                    {"required": ["search_roots"], "not": {"required": ["collection_root"]}}
                  ],
                  "additionalProperties": false
                },
                {"type": "null"}
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authoritative_root": {"type": "string", "minLength": 1},
    "xcode_container": {"type": ["string", "null"], "minLength": 1},
    "private_policy_overlay": {"type": "string", "minLength": 1},
    "run_authorization": {"type": "string", "minLength": 1},
    "run_ledger": {"type": "string", "minLength": 1},
    "resource_coordinator": {
      "type": "object",
      "required": ["state_path", "coordinator_instance_id", "runtime_kind", "runtime_contract", "executable_sha256", "source_bundle_sha256"],
      "properties": {
        "state_path": {
          "type": "string",
          "minLength": 2,
          "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
        },
        "coordinator_instance_id": {"type": "string", "minLength": 1},
        "executable_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "runtime_contract": {
          "const": "apple-verification-core.resources.v1"
        },
        "runtime_kind": {
          "const": "swift"
        },
        "source_bundle_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "apple_observation_probe": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "executable",
            "executable_sha256",
            "output_contract",
            "timeout_seconds"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 2,
              "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "output_contract": {"const": "apple_observation_v1"},
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "spec_kit": {
      "type": "object",
      "required": ["enabled", "release"],
      "properties": {
        "enabled": {"type": "boolean"},
        "release": {"const": "v1.0.1"}
      },
      "additionalProperties": false
    },
    "github_tracking": {
      "type": "object",
      "required": ["issues", "project"],
      "properties": {
        "issues": {"const": true},
        "project": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "max_active_repository_writers": {"const": 1},
    "max_implementation_attempts": {"const": 3},
    "max_review_cycles": {"const": 2},
    "authorization_runtime": {
      "additionalProperties": false,
      "properties": {
        "executable_path": {
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "executable_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "runtime_contract": {
          "const": "apple-verification-core.authorization.v1"
        },
        "runtime_kind": {
          "const": "swift"
        },
        "source_bundle_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "executable_path",
        "executable_sha256",
        "runtime_contract",
        "runtime_kind",
        "source_bundle_sha256"
      ],
      "type": "object"
    },
    "local_requirements": {
      "additionalProperties": false,
      "properties": {
        "review_required": {
          "type": "boolean"
        },
        "spec_kit_required": {
          "type": "boolean"
        }
      },
      "required": [
        "review_required",
        "spec_kit_required"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "runtime_probe_scope": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "additionalProperties": false,
          "properties": {
            "coordinator_instance_id": {
              "minLength": 1,
              "type": "string"
            },
            "destination_id": {
              "minLength": 1,
              "type": "string"
            },
            "platform": {
              "minLength": 1,
              "type": "string"
            },
            "registry_scope": {
              "minLength": 1,
              "type": "string"
            },
            "runtime_identifier": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "coordinator_instance_id",
            "registry_scope",
            "platform",
            "destination_id",
            "runtime_identifier"
          ],
          "type": "object"
        },
        "owner_actor": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "owner_run_id": {
          "minLength": 1,
          "type": "string"
        },
        "run_authority": {
          "minProperties": 1,
          "type": "object"
        },
        "state_path": {
          "pattern": "^/",
          "type": "string"
        },
        "ttl_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "state_path",
        "descriptor",
        "owner_run_id",
        "owner_actor",
        "ttl_seconds",
        "run_authority"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "codex"}}},
      "then": {
        "properties": {
          "selected_writer": {"const": "codex"},
          "reviewer": {"const": null},
          "agent_skills": {
            "properties": {
              "installations": {
                "properties": {
                  "codex": {"type": "object"},
                  "claude": {"const": null}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "claude"}}},
      "then": {
        "properties": {
          "selected_writer": {"const": "claude"},
          "reviewer": {"const": null},
          "agent_skills": {
            "properties": {
              "installations": {
                "properties": {
                  "codex": {"const": null},
                  "claude": {"type": "object"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "collaborative"}}},
      "then": {
        "properties": {
          "agent_skills": {
            "properties": {
              "installations": {
                "properties": {
                  "codex": {"type": "object"},
                  "claude": {"type": "object"}
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "selected_writer": {"const": "codex"},
              "reviewer": {"const": "claude"}
            }
          },
          {
            "properties": {
              "selected_writer": {"const": "claude"},
              "reviewer": {"const": "codex"}
            }
          }
        ]
      }
    },
    {
      "if": {"properties": {"delivery_target": {"const": "pr_ready"}}},
      "then": {
        "properties": {
          "health_profile": {
            "enum": ["pr_ready", "runtime_ui", "icon_upstream"]
          }
        }
      }
    },
    {
      "if": {"properties": {"delivery_target": {"const": "testflight_uploaded"}}},
      "then": {
        "properties": {"health_profile": {"const": "testflight_uploaded"}}
      }
    },
    {
      "if": {"properties": {"delivery_target": {"const": "testflight_distributed"}}},
      "then": {
        "properties": {"health_profile": {"const": "testflight_distributed"}}
      }
    },
    {
      "if": {
        "properties": {
          "spec_kit": {"properties": {"enabled": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "health_components": {"contains": {"const": "spec_kit"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "github_tracking": {"properties": {"project": {"type": "object"}}}
        }
      },
      "then": {
        "properties": {
          "health_components": {"contains": {"const": "github_project"}}
        }
      }
    },
    {
      "else": {
        "properties": {
          "local_requirements": {
            "const": null
          }
        }
      },
      "if": {
        "properties": {
          "delivery_target": {
            "const": "local_verified"
          }
        }
      },
      "then": {
        "properties": {
          "health_profile": {
            "enum": [
              "local_verified",
              "runtime_ui"
            ]
          },
          "local_requirements": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
