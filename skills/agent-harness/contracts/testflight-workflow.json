{
  "$schema": "./schemas/testflight-workflow.schema.json",
  "schema_version": "1.0.0",
  "starts_after": "pr_ready",
  "nodes": [
    {"id": "bind_pr_ready", "requires": []},
    {"id": "verify_run_authorization", "requires": ["bind_pr_ready"]},
    {"id": "health_gate", "requires": ["verify_run_authorization"]},
    {"id": "claim_archive_build", "requires": ["health_gate"], "resource": "build_tuple", "lease_action": "acquire", "protects": ["archive", "verify_artifact"]},
    {"id": "claim_testflight_upload", "requires": ["claim_archive_build"], "resource": "signing_or_app_store_connect", "lease_action": "acquire", "protects": ["archive", "verify_artifact", "release_archive_build", "upload", "wait_processing", "read_back_upload"]},
    {"id": "archive", "requires": ["claim_testflight_upload"]},
    {"id": "verify_artifact", "requires": ["archive"]},
    {"id": "release_archive_build", "requires": ["verify_artifact"], "resource": "build_tuple", "lease_action": "release", "protects": ["archive", "verify_artifact"]},
    {"id": "upload", "requires": ["release_archive_build"], "grant_action": "apple.testflight.upload"},
    {"id": "wait_processing", "requires": ["upload"], "grant_action": "apple.testflight.processing.wait", "timeout_from_authorization": "async_wait_minutes", "retry_bound_from_authorization": "max_transient_retries", "heartbeat_active_lease": true},
    {"id": "read_back_upload", "requires": ["wait_processing"], "grant_action": "apple.testflight.readback"},
    {"id": "release_testflight_upload", "requires": ["read_back_upload"], "resource": "signing_or_app_store_connect", "lease_action": "release", "protects": ["archive", "verify_artifact", "release_archive_build", "upload", "wait_processing", "read_back_upload"]},
    {"id": "claim_upload_evidence_publication", "requires": ["release_testflight_upload"], "resource": "github_external_mutation", "lease_action": "acquire", "protects": ["publish_upload_evidence", "verify_upload_evidence"]},
    {"id": "publish_upload_evidence", "requires": ["claim_upload_evidence_publication"], "grant_action": "github.evidence.publish"},
    {"id": "verify_upload_evidence", "requires": ["publish_upload_evidence"]},
    {"id": "release_upload_evidence_publication", "requires": ["verify_upload_evidence"], "resource": "github_external_mutation", "lease_action": "release", "protects": ["publish_upload_evidence", "verify_upload_evidence"]},
    {"id": "testflight_uploaded", "requires": ["release_upload_evidence_publication"], "terminal_for": "testflight_uploaded"},
    {"id": "claim_testflight_distribution", "requires": ["testflight_uploaded"], "resource": "signing_or_app_store_connect", "lease_action": "acquire", "protects": ["verify_internal_groups", "distribute_internal", "read_back_distribution"]},
    {"id": "verify_internal_groups", "requires": ["claim_testflight_distribution"]},
    {"id": "distribute_internal", "requires": ["verify_internal_groups"], "grant_action": "apple.testflight.distribute_internal"},
    {"id": "read_back_distribution", "requires": ["distribute_internal"], "grant_action": "apple.testflight.readback"},
    {"id": "release_testflight_distribution", "requires": ["read_back_distribution"], "resource": "signing_or_app_store_connect", "lease_action": "release", "protects": ["verify_internal_groups", "distribute_internal", "read_back_distribution"]},
    {"id": "claim_distribution_evidence_publication", "requires": ["release_testflight_distribution"], "resource": "github_external_mutation", "lease_action": "acquire", "protects": ["publish_distribution_evidence", "verify_distribution_evidence"]},
    {"id": "publish_distribution_evidence", "requires": ["claim_distribution_evidence_publication"], "grant_action": "github.evidence.publish"},
    {"id": "verify_distribution_evidence", "requires": ["publish_distribution_evidence"]},
    {"id": "release_distribution_evidence_publication", "requires": ["verify_distribution_evidence"], "resource": "github_external_mutation", "lease_action": "release", "protects": ["publish_distribution_evidence", "verify_distribution_evidence"]},
    {"id": "testflight_distributed", "requires": ["release_distribution_evidence_publication"], "terminal_for": "testflight_distributed"}
  ],
  "delivery_targets": {
    "testflight_uploaded": {
      "terminal_node": "testflight_uploaded",
      "required_grants": [
        "apple.testflight.upload",
        "apple.testflight.processing.wait",
        "apple.testflight.readback",
        "github.evidence.publish"
      ]
    },
    "testflight_distributed": {
      "terminal_node": "testflight_distributed",
      "required_grants": [
        "apple.testflight.upload",
        "apple.testflight.processing.wait",
        "apple.testflight.readback",
        "github.evidence.publish",
        "apple.testflight.distribute_internal",
        "apple.testflight.readback",
        "github.evidence.publish"
      ]
    }
  },
  "policy": {
    "processing_wait_is_bounded": true,
    "distribution_is_internal_groups_only": true,
    "read_back_required": true,
    "evidence_publication_requires_github_lease": true,
    "release_every_acquired_lease_on_blocked_or_terminal": true,
    "forbidden_actions": [
      "apple.app_review_submit",
      "apple.production_release",
      "apple.signing_resource_mutation",
      "credential.scope_expansion",
      "github.auto_merge"
    ]
  },
  "cleanup": {
    "mode": "finally",
    "triggers": ["blocked", "failed_terminal", "cancelled", "success_terminal"],
    "release_active_resources": [
      "build_tuple",
      "signing_or_app_store_connect",
      "github_external_mutation"
    ]
  }
}
