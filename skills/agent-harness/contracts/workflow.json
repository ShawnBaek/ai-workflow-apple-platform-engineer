{
  "$schema": "./schemas/workflow.schema.json",
  "schema_version": "1.0.0",
  "nodes": [
    {"id": "intake", "requires": []},
    {"id": "guard", "requires": ["intake"]},
    {"id": "health", "requires": ["guard"]},
    {"id": "discover", "requires": ["health"]},
    {"id": "discover_spec_kit", "requires": ["discover"]},
    {"id": "plan", "requires": ["discover_spec_kit"]},
    {"id": "approve_plan", "requires": ["plan"]},
    {"id": "branch_approval", "requires": ["approve_plan"]},
    {"id": "bind_spec_kit_snapshot", "requires": ["branch_approval"]},
    {"id": "bind_run_authorization", "requires": ["bind_spec_kit_snapshot"]},
    {"id": "claim_implementation_writer", "requires": ["bind_run_authorization"], "resource": "source_checkout_writer", "lease_action": "acquire", "protects": ["prepare_and_verify_branch", "claim_github_tracking", "ensure_issue_ready", "release_github_tracking", "claim_github_in_progress", "mark_issue_in_progress", "release_github_in_progress", "implement"]},
    {"id": "prepare_and_verify_branch", "requires": ["claim_implementation_writer"]},
    {"id": "claim_github_tracking", "requires": ["prepare_and_verify_branch"], "resource": "github_external_mutation", "lease_action": "acquire", "protects": ["ensure_issue_ready"]},
    {"id": "ensure_issue_ready", "requires": ["claim_github_tracking"]},
    {"id": "release_github_tracking", "requires": ["ensure_issue_ready"], "resource": "github_external_mutation", "lease_action": "release", "protects": ["ensure_issue_ready"]},
    {"id": "claim_github_in_progress", "requires": ["release_github_tracking"], "resource": "github_external_mutation", "lease_action": "acquire", "protects": ["mark_issue_in_progress"]},
    {"id": "mark_issue_in_progress", "requires": ["claim_github_in_progress"]},
    {"id": "release_github_in_progress", "requires": ["mark_issue_in_progress"], "resource": "github_external_mutation", "lease_action": "release", "protects": ["mark_issue_in_progress"]},
    {"id": "implement", "requires": ["release_github_in_progress"]},
    {"id": "release_implementation_writer", "requires": ["implement"], "resource": "source_checkout_writer", "lease_action": "release", "protects": ["prepare_and_verify_branch", "claim_github_tracking", "ensure_issue_ready", "release_github_tracking", "claim_github_in_progress", "mark_issue_in_progress", "release_github_in_progress", "implement"]},
    {"id": "verify", "requires": ["release_implementation_writer"]},
    {"id": "freeze_review", "requires": ["verify"]},
    {"id": "review", "requires": ["freeze_review"]},
    {"id": "converge", "requires": ["review"]},
    {"id": "reverify", "requires": ["converge"]},
    {"id": "prepare_evidence", "requires": ["reverify"]},
    {"id": "prepare_pr", "requires": ["prepare_evidence"]},
    {"id": "repository_confirmation", "requires": ["prepare_pr"]},
    {"id": "claim_delivery_writer", "requires": ["repository_confirmation"], "resource": "source_checkout_writer", "lease_action": "acquire", "protects": ["commit", "claim_github_mutation", "push", "verify_remote_sha"]},
    {"id": "commit", "requires": ["claim_delivery_writer"]},
    {"id": "claim_github_mutation", "requires": ["commit"], "resource": "github_external_mutation", "lease_action": "acquire", "protects": ["push", "verify_remote_sha", "release_delivery_writer", "create_pr", "mark_issue_in_review", "publish_evidence", "verify_published_evidence", "checks"]},
    {"id": "push", "requires": ["claim_github_mutation"]},
    {"id": "verify_remote_sha", "requires": ["push"]},
    {"id": "release_delivery_writer", "requires": ["verify_remote_sha"], "resource": "source_checkout_writer", "lease_action": "release", "protects": ["commit", "claim_github_mutation", "push", "verify_remote_sha"]},
    {"id": "create_pr", "requires": ["release_delivery_writer"]},
    {"id": "mark_issue_in_review", "requires": ["create_pr"]},
    {"id": "publish_evidence", "requires": ["mark_issue_in_review"]},
    {"id": "verify_published_evidence", "requires": ["publish_evidence"]},
    {"id": "checks", "requires": ["verify_published_evidence"]},
    {"id": "release_github_mutation", "requires": ["checks"], "resource": "github_external_mutation", "lease_action": "release", "protects": ["push", "verify_remote_sha", "release_delivery_writer", "create_pr", "mark_issue_in_review", "publish_evidence", "verify_published_evidence", "checks"]},
    {"id": "pr_ready", "requires": ["release_github_mutation"], "terminal": true}
  ],
  "attempt_policy": {
    "max_implementation_attempts": 3,
    "max_review_cycles": 2,
    "max_transient_retries": 1,
    "identical_failure_stop_count": 2,
    "default_active_wall_minutes": 45,
    "pause_while_awaiting_human_or_ci": true
  },
  "runtime_edge_types": [
    "attempt_of",
    "supersedes",
    "produced_by",
    "validates",
    "invalidates",
    "feedback_on",
    "promoted_to",
    "authorized_by",
    "tracks",
    "continues_from",
    "derived_from"
  ],
  "terminal_outcomes": {
    "success": "pr_ready",
    "non_success": ["blocked", "failed_terminal", "cancelled"]
  },
  "identity_policy": {
    "algorithm": "patch_identity_v1",
    "digest": "sha256",
    "base": "base_sha",
    "path_order": "utf8_bytewise",
    "path_record_fields": ["path", "mode", "state", "content_sha256_or_deletion"],
    "commit_equivalence": "commit_tree_and_changed_paths_match_reviewed_identity"
  },
  "completion_requires": [
    "required_nodes_passed",
    "required_health_profile_satisfied",
    "run_authorization_current",
    "spec_kit_snapshot_current_or_not_applicable",
    "latest_evidence_matches_patch_identity",
    "no_active_resource_lease",
    "review_patch_identity_current",
    "acceptance_evidence_complete",
    "evidence_published_and_viewable",
    "pull_request_exists",
    "remote_sha_matches_local_commit",
    "required_checks_satisfied",
    "issue_tracking_reconciled_or_recorded_partial"
  ],
  "cleanup": {
    "mode": "finally",
    "triggers": ["blocked", "failed_terminal", "cancelled", "success_terminal"],
    "release_active_resources": [
      "source_checkout_writer",
      "xcode_project_mutation",
      "build_tuple",
      "simulator_or_device",
      "coresimulator_runtime_registry",
      "macos_gui_session",
      "signing_or_app_store_connect",
      "github_external_mutation"
    ]
  }
}
